# Copy to .env (in this folder, or one folder up) and fill in. Never commit the real .env.
# The app reads .env from this folder first, then from the folder above it.
# With no key at all the app still runs: every agent falls back to its basic, non-AI mode.

# Course key (Yale Portkey gateway). The agents use gpt-6-luna through it.
PORTKEY_API_KEY=

# Optional alternative: a direct OpenAI key (used only if PORTKEY_API_KEY is empty).
OPENAI_API_KEY=
